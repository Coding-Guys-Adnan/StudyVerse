# Database
# Local development default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./studyverse.db
# Production (Supabase PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret & Auth
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Frontend URLs (comma-separated if multiple)
FRONTEND_URL=http://localhost:3005

# Supabase Storage & Service API Keys
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=studyverse-uploads

# Gemini AI (Optional)
GEMINI_API_KEY=your-gemini-api-key

# SMTP Configuration for Email/Password Reset (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@studyverse.com
SMTP_FROM_NAME=StudyVerse
